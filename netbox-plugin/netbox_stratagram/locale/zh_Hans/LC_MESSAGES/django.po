msgid "Diagram"
msgstr "网络图"

#, python-format
msgid "Diagram of %(site)s"
msgstr "%(site)s 的网络图"

#, python-brace-format
msgid "Expected {\"diagram\": ...}."
msgstr "请求体应为 {\"diagram\": ...}。"

msgid "Network diagrams of sites, edited in NetBox"
msgstr "在 NetBox 中编辑站点网络图"

msgid "Not a diagram."
msgstr "网络图数据无效。"

msgid "The diagram editor was not built into this plugin (see build.sh)."
msgstr "此插件未包含网络图编辑器，请使用 build.sh 构建。"

msgid "The diagram is too large."
msgstr "网络图文件过大。"

msgid "This site has a diagram, but you may not view it."
msgstr "此站点已有网络图，你没有查看权限。"

msgid "You may not save diagrams."
msgstr "你没有保存网络图的权限。"

msgid "You may not save this site's diagram."
msgstr "你没有保存此站点网络图的权限。"

msgid "You may not view site diagrams."
msgstr "你没有查看站点网络图的权限。"

msgid "diagram"
msgstr "网络图"

msgid "site"
msgstr "站点"

msgid "site diagram"
msgstr "站点网络图"

msgid "site diagrams"
msgstr "站点网络图"
