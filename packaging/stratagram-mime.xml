<!-- The .stratagram file type for Linux desktops, so file managers show
     diagrams with Stratagram's icon and open them with it (README). -->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-stratagram">
    <comment>Stratagram diagram</comment>
    <sub-class-of type="application/json"/>
    <generic-icon name="stratagram"/>
    <glob pattern="*.stratagram"/>
  </mime-type>
</mime-info>
